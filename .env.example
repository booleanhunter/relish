SERVER_PORT=3000
NODE_ENV=development
APP_NAME=Relish # Application name (displayed in UI)

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL_NAME=gpt-4o-mini

REDIS_URL=redis://127.0.0.1:6379

# LangCache API Key, get from: https://redis.io/langcache
# Required: Yes (for semantic caching)
LANGCACHE_API_KEY=your-langcache-api-key-here
LANGCACHE_CACHE_ID=your-cache-id-here
LANGCACHE_API_BASE_URL=https://api.langcache.io

# Optional: LangSmith Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=relish-restaurant-agent
